{
  "name": "leboncivique",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Le bon civique : informations et entraînement à l'examen civique (site non officiel).",
  "scripts": {
    "dev": "astro build && wrangler dev",
    "build": "astro build",
    "check": "astro check && tsc -p worker/tsconfig.json --noEmit",
    "test": "node --test worker/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply leboncivique --local",
    "db:migrate:remote": "wrangler d1 migrations apply leboncivique --remote",
    "seed": "node scripts/build-seed.mjs",
    "deploy": "astro build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.2",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261024.1",
    "typescript": "5.9.3",
    "wrangler": "4.153.0"
  }
}
