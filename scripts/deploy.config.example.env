# Copier ce fichier en scripts/deploy.config.env puis compléter.
# Ce fichier ne contient aucun secret : les secrets sont demandés par le script
# et stockés chez Cloudflare (wrangler secret put).

# Domaine de production (sans https://)
DOMAIN=leboncivique.fr

# Région de la base D1 (weur = Europe de l'Ouest, données en Europe)
D1_LOCATION=weur

# Clé PUBLIQUE (site key) du widget Turnstile « Managed » créé pour le domaine
PUBLIC_TURNSTILE_SITEKEY=
