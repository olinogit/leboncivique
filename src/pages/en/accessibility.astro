import Base from '../../layouts/Base.astro';
---
<Base lang="en" page="a11y" title="Accessibility statement" description="Accessibility commitments of Le bon civique (RGAA 4.1, WCAG 2.2 AA).">
  <div class="prose">
    <h1>Accessibility</h1>
    <p>Le bon civique aims to comply with RGAA 4.1 and WCAG 2.2 level AA. It has not been externally audited yet (status: <b>not assessed</b>).</p>
    <ul>
      <li>Full keyboard navigation, skip link and visible focus.</li>
      <li>High contrast, automatic dark theme, text resizable to 200%.</li>
      <li>Feedback and remaining time announced to screen readers.</li>
      <li>Dyslexia-friendly font option at the bottom of each page.</li>
    </ul>
    <p>Problem accessing content? Email <a href="mailto:contact@leboncivique.fr">contact@leboncivique.fr</a>.</p>
  </div>
</Base>
